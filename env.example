# Trading Analysis App - Environment Configuration
# ================================================

# RECOMMENDED SETUP (Start with this - App works perfectly with just these!)
# ---------------------------------------------------------------------------

# Google Gemini AI API Key (Optional but recommended for AI insights)
# Get free key from: https://aistudio.google.com
GEMINI_API_KEY=

# Flask Configuration (Optional - has sensible defaults)
FLASK_SECRET_KEY=change_this_to_something_random
FLASK_ENV=development


# OPTIONAL: ZERODHA KITE INTEGRATION (ONLY for portfolio features)
# -----------------------------------------------------------------------
# ⚠️  WARNING: Kite Connect costs ₹2000/month + GST
# ⚠️  Access token expires DAILY and requires regeneration
# ⚠️  SKIP THIS unless you specifically need portfolio integration
#
# Stock analysis features work perfectly WITHOUT Kite using free Yahoo Finance data!
# 
# If you really need portfolio features:
# 1. Get API Key & Secret from: https://kite.zerodha.com/connect/login
# 2. Generate access token using:
#    python -c "from utils.kite_handler import KiteHandler; KiteHandler.generate_access_token('your_key', 'your_secret')"
# 3. Token must be regenerated EVERY DAY after 7:30 AM

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=


# QUICK START INSTRUCTIONS:
# -------------------------
# 1. Copy this file to .env:
#    cp env.example .env
#
# 2. (Optional) Add your Gemini API key for AI insights
#
# 3. Run the app:
#    python app.py
#
# 4. Open browser: http://localhost:5000
#
# 5. Start analyzing stocks! (No broker account needed)


